#!/bin/bash

# Two-lane multi-lane retraining with checkpoint-gated model selection.
# Geometry is 2 lanes with ego lane 1, so the only escape is a left lane
# change. Each policy saves a checkpoint every 5,000 steps; the run then keeps
# the latest checkpoint that passes the frozen development eligibility gate.
# The sealed held-out grid is never loaded here.

#PBS -N multilane-2lane-sel
#PBS -J 0-19
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
if [[ ! -f "${VENV_DIR}/bin/activate" ]]; then
  echo "Missing Python environment: ${VENV_DIR}" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python3 -c \
  "import gymnasium, highway_env, stable_baselines3, torch; print(f'Python environment OK: torch={torch.__version__}, cuda={torch.cuda.is_available()}')"

RUN_SEED=$((4000 + PBS_ARRAY_INDEX))
RUN_NAME="multilane_open_lane_change_twolane_selected_100k_seed${RUN_SEED}"

OUTPUT_ROOT="/srv/scratch/${USER}/highway_transition_timing/outputs"
RUN_DIR="${OUTPUT_ROOT}/${RUN_NAME}"
mkdir -p "${RUN_DIR}"

python3 experiments/multilane_open_lane_change/run.py audit \
  --out "${RUN_DIR}/training_scenario_audit" \
  --num-resets 2000 \
  --duration 20 \
  --evaluation-duration 120 \
  --seed "${RUN_SEED}" \
  --lanes-count 2 \
  --ego-lane 1 \
  --training-scenario-profile stratified \
  --near-matched-speed-delta 2.0

python3 experiments/multilane_open_lane_change/run.py \
  --out "${RUN_DIR}" \
  --agents FD BAL SP \
  --timesteps 100000 \
  --checkpoint-every 5000 \
  --num-exposures 36 \
  --duration 20 \
  --evaluation-duration 120 \
  --seed "${RUN_SEED}" \
  --lanes-count 2 \
  --ego-lane 1 \
  --learning-rate 0.0005 \
  --training-scenario-profile stratified \
  --near-matched-speed-delta 2.0 \
  --lane-change-penalty 0.2 \
  --slow-down-penalty 0.2 \
  --collision-risk-penalty 3.0 \
  --bootstrap-samples 500 \
  --verbose 0 \
  --no-figures

for agent in FD BAL SP; do
  MODEL_PATH="${RUN_DIR}/models/${agent}_main.zip"
  if [[ ! -f "${MODEL_PATH}" ]]; then
    echo "Missing selected model: ${MODEL_PATH}" >&2
    exit 1
  fi
done

SELECTION_PATH="${RUN_DIR}/model_selection.csv"
if [[ ! -f "${SELECTION_PATH}" ]]; then
  echo "Missing selection record: ${SELECTION_PATH}" >&2
  exit 1
fi

echo "Completed ${RUN_NAME}: lanes=2 ego_lane=1 checkpoints=5000 heldout=unopened"
