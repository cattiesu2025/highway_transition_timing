#!/bin/bash

# Arm B: two-lane retraining with an empty target lane, on the corrected
# difficulty bands and evaluation grid. This is the clean version of the
# completed twolane_selected runs, whose null result stands and is reported
# regardless of what arm C shows. The evaluation grid moved from
# 140/180/220/260 m to 150/165/180/195 m: the old 220 and 260 m levels sat
# beyond the 200 m observation clip and the 195 m training range, so in half
# its scenes the policy could not perceive the hazard at t=0.
#
# Arms B and C differ in one variable, the target-lane occupancy. Seeds are a
# new block so the completed 4000-4019 runs stay intact as superseded
# evidence. The sealed held-out grid is never loaded here.

#PBS -N armB-2lane-open
#PBS -J 0-19
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
if [[ ! -f "${VENV_DIR}/bin/activate" ]]; then
  echo "Missing Python environment: ${VENV_DIR}" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python3 -c \
  "import gymnasium, highway_env, stable_baselines3, torch; print(f'Python environment OK: torch={torch.__version__}, cuda={torch.cuda.is_available()}')"

RUN_SEED=$((4100 + PBS_ARRAY_INDEX))
RUN_NAME="multilane_twolane_open_fixed_100k_seed${RUN_SEED}"

OUTPUT_ROOT="/srv/scratch/${USER}/highway_transition_timing/outputs"
RUN_DIR="${OUTPUT_ROOT}/${RUN_NAME}"
mkdir -p "${RUN_DIR}"

python3 experiments/multilane_open_lane_change/run.py audit \
  --out "${RUN_DIR}/training_scenario_audit" \
  --num-resets 2000 \
  --duration 20 \
  --evaluation-duration 120 \
  --seed "${RUN_SEED}" \
  --lanes-count 2 \
  --ego-lane 1 \
  --training-scenario-profile stratified \
  --near-matched-speed-delta 2.0

python3 experiments/multilane_open_lane_change/run.py \
  --out "${RUN_DIR}" \
  --agents FD BAL SP \
  --timesteps 100000 \
  --checkpoint-every 5000 \
  --num-exposures 36 \
  --duration 20 \
  --evaluation-duration 120 \
  --seed "${RUN_SEED}" \
  --lanes-count 2 \
  --ego-lane 1 \
  --learning-rate 0.0005 \
  --training-scenario-profile stratified \
  --near-matched-speed-delta 2.0 \
  --lane-change-penalty 0.2 \
  --slow-down-penalty 0.2 \
  --collision-risk-penalty 3.0 \
  --bootstrap-samples 500 \
  --verbose 0 \
  --no-figures

for agent in FD BAL SP; do
  MODEL_PATH="${RUN_DIR}/models/${agent}_main.zip"
  if [[ ! -f "${MODEL_PATH}" ]]; then
    echo "Missing selected model: ${MODEL_PATH}" >&2
    exit 1
  fi
done

if [[ ! -f "${RUN_DIR}/model_selection.csv" ]]; then
  echo "Missing selection record: ${RUN_DIR}/model_selection.csv" >&2
  exit 1
fi

echo "Completed ${RUN_NAME}: arm=B lanes=2 target_lane=empty grid=150-195 heldout=unopened"
