#!/bin/bash
# Score-normalisation pilot SN1: S=clip((v-10)/25), D=clip(d/200), first-log equal start.
# Index layout (experiments/score_normalization/jobs.json), 2 paired seeds per cell:
#   0-5   Arm A  BAL, SP, FD   (seeds 3100, 3101)
#   6-11  Arm B  BAL, SP, FD   (seeds 4100, 4101)
#   12-17 Arm C  BAL, SP, FD   (seeds 4200, 4201)
#   18-23 Arm D  BAL, SP, FD   (seeds 4200, 4201)
# Set VENV_BUNDLE to the directory printed by katana_pack_training_env.sh.
# Submit from the source snapshot: qsub -v VENV_BUNDLE scripts/katana_score_normalization.pbs
#PBS -N score-norm-sn1
#PBS -J 0-23
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=07:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
: "${PBS_ARRAY_INDEX:?Array index is required}"
module load python/3.11.3
: "${VENV_BUNDLE:?Set VENV_BUNDLE to the prepared snapshot directory}"
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
ARM=$(python3 -S -c 'import json,sys; print(json.load(open("experiments/score_normalization/jobs.json"))[int(sys.argv[1])]["arm"])' "$PBS_ARRAY_INDEX")
if [[ "$ARM" == D ]]; then
  # Match the thread settings of the original Arm D training jobs.
  export OMP_NUM_THREADS=1
  export OPENBLAS_NUM_THREADS=1
fi
LOCAL_ROOT=/tmp/highway-score-norm
mkdir -p -m 700 "$LOCAL_ROOT"
python3 -S scripts/katana_local_env.py --shared-env --local-root "$LOCAL_ROOT" --bundle "$VENV_BUNDLE" -- \
  bash -c 'set -euo pipefail
    source scripts/katana_headless_setup.sh
    python3 experiments/score_normalization/run.py \
      --index "$1" \
      --out-root "/srv/scratch/${USER}/highway_transition_timing/outputs" \
      --execute
  ' highway-score-norm "$PBS_ARRAY_INDEX"
