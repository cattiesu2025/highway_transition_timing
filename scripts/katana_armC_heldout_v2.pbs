#!/bin/bash

# One-time held-out v2 inference for Arm C. No training or model selection.
#PBS -N armC-ho-v2
#PBS -J 0-19
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
[[ -f "${VENV_DIR}/bin/activate" ]] || { echo "Missing ${VENV_DIR}" >&2; exit 1; }
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

RUN_SEED=$((4200 + PBS_ARRAY_INDEX))
RUN_NAME="multilane_twolane_occupied_fixed_100k_seed${RUN_SEED}"
RUN_DIR="/srv/scratch/${USER}/highway_transition_timing/outputs/${RUN_NAME}"
OUT_DIR="${RUN_DIR}/rollout_counterfactual_heldout_v2"

for agent in FD BAL SP; do
  [[ -f "${RUN_DIR}/models/${agent}_main.zip" ]] || {
    echo "Missing selected model for ${RUN_NAME}: ${agent}" >&2; exit 1;
  }
done

python3 experiments/multilane_open_lane_change/rollout_counterfactual.py \
  --run-dir "${RUN_DIR}" \
  --out "${OUT_DIR}" \
  --eval-grid heldout-v2 \
  --agents FD BAL SP \
  --num-exposures 36 \
  --evaluation-duration 120 \
  --variants original no-front matched-speed-front far-front open-target-lane

[[ -f "${OUT_DIR}/evaluation_grid_manifest.csv" ]] || {
  echo "Missing held-out manifest for ${RUN_NAME}" >&2; exit 1;
}
[[ -f "${OUT_DIR}/original/analysis/actual_lane_change_summary.csv" ]] || {
  echo "Missing original outcomes for ${RUN_NAME}" >&2; exit 1;
}

echo "Completed ${RUN_NAME}: arm=C grid=heldout-v2 inference_only=yes"
