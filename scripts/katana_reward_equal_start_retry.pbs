#!/bin/bash
# Retry equal-start tasks whose node had a damaged shared environment cache.
# Stages a private environment (no --shared-env), so a bad node cache is never read.
# Pass the indices with -J, e.g.:
#   qsub -J 10-11 -v VENV_BUNDLE scripts/katana_reward_equal_start_retry.pbs
#PBS -N reward-equal-start-retry
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
: "${PBS_ARRAY_INDEX:?Array index is required; submit with -J}"
module load python/3.11.3
: "${VENV_BUNDLE:?Set VENV_BUNDLE to the prepared snapshot directory}"
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
python3 -S scripts/katana_local_env.py --bundle "$VENV_BUNDLE" -- \
  bash -c 'set -euo pipefail
    source scripts/katana_headless_setup.sh
    python3 experiments/reward_equal_start/run.py \
      --index "$1" \
      --out-root "/srv/scratch/${USER}/highway_transition_timing/outputs" \
      --execute
  ' highway-equal-start "$PBS_ARRAY_INDEX"
