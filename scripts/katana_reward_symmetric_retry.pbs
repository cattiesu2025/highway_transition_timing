#!/bin/bash
# Retry one condition, default index 2 (A/R7/3102).
# qsub -v SWEEP_INDEX=2 scripts/katana_reward_symmetric_retry.pbs
# Archive a failed run directory before retraining; never overwrite it.
#PBS -N reward-retry
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=05:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
module load python/3.11.3
source "/srv/scratch/${USER}/venvs/highway-transition/bin/activate"
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
source scripts/katana_headless_setup.sh
python3 experiments/reward_sensitivity/run_symmetric.py \
  --index "${SWEEP_INDEX:-2}" \
  --out-root "/srv/scratch/${USER}/highway_transition_timing/outputs" \
  --phase "${SWEEP_PHASE:-train}" --execute
