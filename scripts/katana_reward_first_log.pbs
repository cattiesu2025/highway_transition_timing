#!/bin/bash
# First-log equal-start reward training: 30 new models (BAL reused, Arm C unchanged).
#   0-9   Arm A  SP/FD x seeds 3100-3104
#   10-19 Arm B  SP/FD x seeds 4100-4104
#   20-29 Arm D  SP/FD x seeds 4200-4204
# Set VENV_BUNDLE to the directory printed by katana_pack_training_env.sh.
# Submit from the source snapshot: qsub -v VENV_BUNDLE scripts/katana_reward_first_log.pbs
# Retry selected indices with: qsub -J <a>-<b> -v VENV_BUNDLE scripts/katana_reward_first_log.pbs
#PBS -N reward-first-log
#PBS -J 0-29
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=07:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
: "${PBS_ARRAY_INDEX:?Array index is required (0-29)}"
module load python/3.11.3
: "${VENV_BUNDLE:?Set VENV_BUNDLE to the prepared snapshot directory}"
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
if (( PBS_ARRAY_INDEX >= 20 )); then
  # Match the thread settings of the original Arm D training jobs.
  export OMP_NUM_THREADS=1
  export OPENBLAS_NUM_THREADS=1
fi
# Fresh local root: its own lock and cache, never the damaged default cache on k180.
LOCAL_ROOT=/tmp/highway-first-log
mkdir -p -m 700 "$LOCAL_ROOT"
python3 -S scripts/katana_local_env.py --shared-env --local-root "$LOCAL_ROOT" --bundle "$VENV_BUNDLE" -- \
  bash -c 'set -euo pipefail
    source scripts/katana_headless_setup.sh
    python3 experiments/reward_equal_start/run_first_log.py \
      --index "$1" \
      --out-root "/srv/scratch/${USER}/highway_transition_timing/outputs" \
      --execute
  ' highway-first-log "$PBS_ARRAY_INDEX"
