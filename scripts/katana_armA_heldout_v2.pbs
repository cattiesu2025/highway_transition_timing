#!/bin/bash

# One-time held-out v2 inference for Arm A. No training or model selection.
#PBS -N armA-ho-v2
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
[[ -f "${VENV_DIR}/bin/activate" ]] || { echo "Missing ${VENV_DIR}" >&2; exit 1; }
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

TASK_INDEX="${ARM_A_INDEX:-${PBS_ARRAY_INDEX:-}}"
[[ "${TASK_INDEX}" =~ ^([0-9]|1[0-9])$ ]] || {
  echo "Set ARM_A_INDEX=0..19 for one seed, or submit with -J 0-19" >&2
  exit 2
}
RUN_SEED=$((3100 + TASK_INDEX))
RUN_NAME="single_lane_slow_front_fixed_100k_seed${RUN_SEED}"
RUN_DIR="/srv/scratch/${USER}/highway_transition_timing/outputs/${RUN_NAME}"
OUT_DIR="${RUN_DIR}/rollout_counterfactual_heldout_v2"

for agent in FD BAL SP; do
  [[ -f "${RUN_DIR}/models/${agent}_main.zip" ]] || {
    echo "Missing selected model for ${RUN_NAME}: ${agent}" >&2; exit 1;
  }
done

echo "Starting Arm A held-out v2: index=${TASK_INDEX} seed=${RUN_SEED} host=$(hostname)"
python3 experiments/single_lane_slow_front/run.py rollout-counterfactual \
  --run-dir "${RUN_DIR}" \
  --out "${OUT_DIR}" \
  --eval-grid heldout-v2 \
  --agents FD BAL SP \
  --num-exposures 36 \
  --seed "${RUN_SEED}" \
  --duration 20 \
  --evaluation-duration 120 \
  --collision-risk-penalty 3.0 \
  --reward-strength-multiplier 1 \
  --counterfactual-variants original no-front matched-speed-front far-front \
  --bootstrap-samples 500 \
  --no-figures

[[ -f "${OUT_DIR}/evaluation_grid_manifest.csv" ]] || {
  echo "Missing held-out manifest for ${RUN_NAME}" >&2; exit 1;
}
[[ -f "${OUT_DIR}/original/analysis/episode_outcomes.csv" ]] || {
  echo "Missing original outcomes for ${RUN_NAME}" >&2; exit 1;
}

echo "Completed ${RUN_NAME}: arm=A grid=heldout-v2 inference_only=yes"
