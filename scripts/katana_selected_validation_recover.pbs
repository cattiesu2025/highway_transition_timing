#!/bin/bash
# Audited 53 startup failures from array 9543211; preserve 127 successful tasks.
#PBS -N selected-val-recover
#PBS -J 0-52
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
missing=(42 51 52 53 54 55 56 57 59 60 88 89 90 91 92 94 95 98 99 102 103 105 108 112 113 114 115 116 117 118 119 120 122 123 124 125 126 128 135 140 141 142 143 144 145 146 147 148 150 154 157 158 161)
: "${PBS_ARRAY_INDEX:?Recovery array index is required}"
if [[ ! "$PBS_ARRAY_INDEX" =~ ^[0-9]+$ ]] || (( PBS_ARRAY_INDEX > 52 )); then
  echo "Invalid recovery slot: $PBS_ARRAY_INDEX" >&2
  exit 2
fi
export VALIDATION_INDEX="${missing[$PBS_ARRAY_INDEX]}"
# All 53 failed before the runner; reused-model tasks automatically evaluate only.
export VALIDATION_PHASE=complete
echo "Recovery slot $PBS_ARRAY_INDEX -> original validation task $VALIDATION_INDEX"
source scripts/katana_selected_validation_retry.pbs
