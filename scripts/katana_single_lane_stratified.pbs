#!/bin/bash

#PBS -N single-lane-stratified
#PBS -J 0-4
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
if [[ ! -f "${VENV_DIR}/bin/activate" ]]; then
  echo "Missing Python environment: ${VENV_DIR}" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python3 -c \
  "import gymnasium, highway_env, stable_baselines3, torch; print(f'Python environment OK: torch={torch.__version__}, cuda={torch.cuda.is_available()}')"

RUN_SEED="${PBS_ARRAY_INDEX}"
RUN_NAME="single_lane_slow_front_stratified_100k_seed${RUN_SEED}"

OUTPUT_ROOT="/srv/scratch/${USER}/highway_transition_timing/outputs"
mkdir -p "${OUTPUT_ROOT}"

python3 experiments/single_lane_slow_front/run.py audit \
  --out "${OUTPUT_ROOT}/${RUN_NAME}_audit" \
  --num-resets 2000 \
  --seed "${RUN_SEED}"

python3 experiments/single_lane_slow_front/run.py \
  --out "${OUTPUT_ROOT}/${RUN_NAME}" \
  --agents FD BAL SP \
  --timesteps 100000 \
  --num-exposures 36 \
  --duration 120 \
  --evaluation-duration 120 \
  --seed "${RUN_SEED}" \
  --bootstrap-samples 500 \
  --verbose 0
