#!/bin/bash
# Selected-weight validation: 180 tasks; 45 reuse models, 135 train then evaluate.
# Set VENV_BUNDLE to the directory printed by katana_pack_training_env.sh.
#PBS -N selected-validation
#PBS -J 0-179
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
: "${PBS_ARRAY_INDEX:?Validation array index is required (0-179)}"
module load python/3.11.3
: "${VENV_BUNDLE:?Set VENV_BUNDLE to the prepared snapshot directory}"
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
# Lock preparation only; verified environment is shared, training runs concurrently.
# The module interpreter uses only stdlib; the child uses the staged interpreter.
python3 -S scripts/katana_local_env.py --shared-env --bundle "$VENV_BUNDLE" -- \
  bash -c 'set -euo pipefail
    source scripts/katana_headless_setup.sh
    python3 experiments/reward_sensitivity/run_selected_validation.py \
      --index "$1" \
      --out-root "/srv/scratch/${USER}/highway_transition_timing/outputs" \
      --phase "${VALIDATION_PHASE:-complete}" --execute
  ' highway-validation "$PBS_ARRAY_INDEX"
