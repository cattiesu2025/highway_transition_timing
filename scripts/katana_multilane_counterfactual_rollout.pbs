#!/bin/bash

#PBS -N multilane-cf
#PBS -J 0-4
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
if [[ ! -f "${VENV_DIR}/bin/activate" ]]; then
  echo "Missing Python environment: ${VENV_DIR}" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python3 -c \
  "import gymnasium, highway_env, stable_baselines3, torch; print(f'Python environment OK: torch={torch.__version__}, cuda={torch.cuda.is_available()}')"

RUN_SEED="${PBS_ARRAY_INDEX}"
RUN_NAME="multilane_open_lane_change_mixed_100k_seed${RUN_SEED}"
RUN_DIR="/srv/scratch/${USER}/highway_transition_timing/outputs/${RUN_NAME}"

for agent in FD BAL SP; do
  MODEL_PATH="${RUN_DIR}/models/${agent}_main.zip"
  if [[ ! -f "${MODEL_PATH}" ]]; then
    echo "Missing trained model: ${MODEL_PATH}" >&2
    exit 1
  fi
done

python3 experiments/multilane_open_lane_change/rollout_counterfactual.py \
  --run-dir "${RUN_DIR}" \
  --agents FD BAL SP \
  --variants original no-front matched-speed-front far-front \
  --num-exposures 36 \
  --evaluation-duration 120
