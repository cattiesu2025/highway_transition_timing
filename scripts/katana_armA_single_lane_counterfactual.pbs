#!/bin/bash

# Arm A counterfactual battery, run independently of model selection.
#
# The per-variant numbers reported so far come from the selection gate, which
# required zero no-front onsets and a minimum delay under both weakened
# variants. The direction of those effects is therefore not independent
# evidence: the checkpoint was chosen because it produced them. This array
# re-runs the same four variants on the already-selected policies as a
# standalone rollout, so the controls are measured without having chosen the
# policies they describe.
#
# The second command records the opening action under each variant, taken
# before any simulation time elapses. That is what localises the response cue:
# the onset says the policy reacted to the hazard, the opening action says
# which property of the hazard it tracked.
#
# Inference only. No training, no checkpoint selection, and the development
# grid throughout: the sealed held-out grid is never loaded here.

#PBS -N armA-cf
#PBS -J 0-19
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
if [[ ! -f "${VENV_DIR}/bin/activate" ]]; then
  echo "Missing Python environment: ${VENV_DIR}" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

RUN_SEED=$((3100 + PBS_ARRAY_INDEX))
RUN_NAME="single_lane_slow_front_fixed_100k_seed${RUN_SEED}"
RUN_DIR="/srv/scratch/${USER}/highway_transition_timing/outputs/${RUN_NAME}"

if [[ ! -d "${RUN_DIR}/models" ]]; then
  echo "Missing completed run: ${RUN_DIR}" >&2
  exit 1
fi

# The scenario flags must match the training array exactly, because the
# evaluation grid and the exposure seeds are derived from them.
COMMON_ARGS=(
  --run-dir "${RUN_DIR}"
  --agents FD BAL SP
  --num-exposures 36
  --seed "${RUN_SEED}"
  --evaluation-duration 120
  --duration 20
  --collision-risk-penalty 3.0
  --reward-strength-multiplier 1
  --counterfactual-variants original no-front matched-speed-front far-front
)

python3 experiments/single_lane_slow_front/run.py rollout-counterfactual \
  "${COMMON_ARGS[@]}" \
  --bootstrap-samples 500 \
  --no-figures

python3 experiments/single_lane_slow_front/run.py counterfactual \
  "${COMMON_ARGS[@]}"

for name in rollout_counterfactual_front_vehicle counterfactual_front_vehicle; do
  if [[ ! -d "${RUN_DIR}/${name}" ]]; then
    echo "Missing counterfactual output: ${RUN_DIR}/${name}" >&2
    exit 1
  fi
done

echo "Completed ${RUN_NAME}: arm=A variants=4 selection_independent=yes heldout=unopened"
