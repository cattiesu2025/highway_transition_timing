#!/bin/bash
# 3 paired seeds x FD/BAL/SP, final fixed 100k checkpoint, independent pilot.
#PBS -N larger-gap-pilot
#PBS -J 0-8
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=05:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
module load python/3.11.3
source "/srv/scratch/${USER}/venvs/highway-transition/bin/activate"
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"
python3 experiments/larger_target_gap/run.py --index "${PBS_ARRAY_INDEX}" \
  --out-root "/srv/scratch/${USER}/highway_transition_timing/outputs" --execute
