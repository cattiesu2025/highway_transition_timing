#!/bin/bash

# Instrumented BAL-only diagnosis for one failed and one safe training seed.
# Array index 0 -> seed 4016; index 1 -> seed 4017.

#PBS -N ml-d20-bal-diag
#PBS -J 0-1
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module load python/3.11.3

VENV_DIR="/srv/scratch/${USER}/venvs/highway-transition"
if [[ ! -f "${VENV_DIR}/bin/activate" ]]; then
  echo "Missing Python environment: ${VENV_DIR}" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"

export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
export XDG_CACHE_HOME="${TMPDIR}/cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

python3 -c \
  "import gymnasium, highway_env, stable_baselines3, torch; print(f'Python environment OK: torch={torch.__version__}, cuda={torch.cuda.is_available()}')"

DIAGNOSTIC_SEEDS=(4016 4017)
if (( PBS_ARRAY_INDEX < 0 || PBS_ARRAY_INDEX >= ${#DIAGNOSTIC_SEEDS[@]} )); then
  echo "Unexpected PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX}; expected 0 or 1" >&2
  exit 1
fi
RUN_SEED="${DIAGNOSTIC_SEEDS[${PBS_ARRAY_INDEX}]}"
RUN_NAME="multilane_open_lane_change_duration20_100k_instrumented_bal_seed${RUN_SEED}"

OUTPUT_ROOT="/srv/scratch/${USER}/highway_transition_timing/outputs"
RUN_DIR="${OUTPUT_ROOT}/${RUN_NAME}"
if [[ -e "${RUN_DIR}" ]]; then
  echo "Refusing to overwrite existing diagnostic directory: ${RUN_DIR}" >&2
  exit 1
fi
mkdir -p "${RUN_DIR}"

python3 experiments/multilane_open_lane_change/run.py audit \
  --out "${RUN_DIR}/training_scenario_audit" \
  --num-resets 2000 \
  --duration 20 \
  --evaluation-duration 120 \
  --seed "${RUN_SEED}" \
  --lanes-count 4 \
  --ego-lane 1 \
  --training-scenario-profile stratified \
  --near-matched-speed-delta 2.0

python3 experiments/multilane_open_lane_change/train_instrumented.py \
  --out "${RUN_DIR}" \
  --seed "${RUN_SEED}" \
  --timesteps 100000 \
  --checkpoint-every 5000 \
  --num-exposures 36 \
  --duration 20 \
  --evaluation-duration 120 \
  --bootstrap-samples 500 \
  --verbose 0

REQUIRED_FILES=(
  "${RUN_DIR}/models/BAL_main.zip"
  "${RUN_DIR}/instrumentation/checkpoints/BAL_step_100000.zip"
  "${RUN_DIR}/instrumentation/replay_buffers/BAL_step_100000.pkl"
  "${RUN_DIR}/instrumentation/q_risk_surface.csv"
  "${RUN_DIR}/instrumentation/cumulative_action_counts.csv"
  "${RUN_DIR}/instrumentation/replay_buffer_summary.csv"
  "${RUN_DIR}/instrumentation/development_checkpoint_summary.csv"
  "${RUN_DIR}/analysis/actual_lane_change_summary.csv"
)

for required_file in "${REQUIRED_FILES[@]}"; do
  if [[ ! -f "${required_file}" ]]; then
    echo "Missing diagnostic artifact: ${required_file}" >&2
    exit 1
  fi
done

echo "Completed ${RUN_NAME}: BAL-only, checkpoints=5000, heldout=unopened"
