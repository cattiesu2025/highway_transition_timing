#!/bin/bash
# Same B/BAL/S10 training, with an unchanged venv snapshot staged in node /tmp.
#PBS -N overtake-local
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=05:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
: "${VENV_BUNDLE:?Set VENV_BUNDLE to the snapshot directory}"
run_name="${OVERTAKE_RUN_NAME:-full_B_BAL_S10_seed4190_local_retry1}"
if [[ ! "$run_name" =~ ^[A-Za-z0-9_-]+$ ]]; then exit 2; fi
out_root="/srv/scratch/${USER}/highway_transition_timing/outputs/overtake_success_return_pilot"
mkdir -p "${out_root}/startup_logs"
exec >"${out_root}/startup_logs/${PBS_JOBID}.log" 2>&1
echo "Job ${PBS_JOBID}; node $(hostname); started $(date -Iseconds)"
set -x
module load python/3.11.3
test -f "${VENV_BUNDLE}/venv.tar"
test -f "${VENV_BUNDLE}/venv.tar.sha256"
test ! -e "${out_root}/${run_name}"

local_work=$(mktemp -d "/tmp/overtake-local.${PBS_JOBID%%.*}.XXXXXX")
trap 'rm -rf -- "$local_work"' EXIT
export TMPDIR="${local_work}/tmp"
mkdir -p "$TMPDIR" "${local_work}/venv"
echo "STAGE: copying unchanged environment to ${local_work}"
df -h "$local_work"
timeout --signal=TERM --kill-after=10s 300s \
  cp "${VENV_BUNDLE}/venv.tar" "${VENV_BUNDLE}/venv.tar.sha256" "$local_work/"
(cd "$local_work" && sha256sum -c venv.tar.sha256)
echo "STAGE: unpacking environment"
timeout --signal=TERM --kill-after=10s 300s \
  tar -xf "${local_work}/venv.tar" -C "${local_work}/venv"
# The copied activation script contains the old shared path; do not source it.
export VIRTUAL_ENV="${local_work}/venv"
export PATH="${VIRTUAL_ENV}/bin:${PATH}"
export EXPECTED_LOCAL_VENV="$VIRTUAL_ENV"
export PYTHONNOUSERSITE=1
unset PYTHONHOME
export PYTHONPATH="${PBS_O_WORKDIR}/src"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
hash -r
source scripts/katana_headless_setup.sh

python3 -u experiments/overtake_success/pilot.py train \
  --arm B --agent BAL --seed 4190 --group S10 --steps 100000 \
  --out "/srv/scratch/${USER}/highway_transition_timing/outputs/overtake_success_return_pilot/${run_name}"
cp "${local_work}/venv.tar.sha256" "${out_root}/${run_name}/environment_snapshot.sha256"
